{
  "name": "dsh-session-management-t",
  "version": "1.0.0",
  "type": "module",
  "description": "Manage DeepSeek Harness sessions: list, archive, pin, stop, rename, and permanently delete session logs — from a Settings page, the /sessions command, or the session_manage tool.",
  "keywords": ["dsh", "deepseek-harness", "plugin", "cordis", "session", "management"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chengeat/dsh-session-management.git"
  },
  "bugs": {
    "url": "https://github.com/Chengeat/dsh-session-management/issues"
  },
  "homepage": "https://github.com/Chengeat/dsh-session-management#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README-zh.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-context-menu"]
    }
  }
}
